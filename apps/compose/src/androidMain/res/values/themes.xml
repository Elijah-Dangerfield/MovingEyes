<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Black, and a dark parent. The app is a black canvas from the first frame
      it draws; a light splash means a white flash before it, which on an OLED
      in a dark room is the brightest thing that will happen all evening.
    -->
    <style name="Theme.MovingEyes" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:statusBarColor">@color/splash_background</item>
        <item name="android:navigationBarColor">@color/splash_background</item>
        <!-- Also the window background, so the frame between the splash
             finishing and Compose drawing is black rather than a flash. -->
        <item name="android:windowBackground">@color/splash_background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- True black, matching the canvas exactly. See ColorResource.Canvas. -->
    <color name="splash_background">#000000</color>
</resources>
