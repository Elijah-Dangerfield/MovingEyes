<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.dangerfield.movingeyes.maintenance</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!--
	  Without this key the generated plist defaults CFBundleName to
	  $(PRODUCT_NAME), and App Store delivery rejects names that are
	  already taken by another app (ITMS-90129). Keep it set to the
	  app's display name; it must be unique on the App Store.
	-->
	<key>CFBundleName</key>
	<string>Moving Eyes</string>
	<key>NSUserNotificationsUsageDescription</key>
	<string>We'd like to send you notifications.</string>
	<!-- Answers Apple's export compliance question at build time instead of
	     leaving every upload stuck on "Missing Compliance" in TestFlight until
	     someone clicks through the dialog. False is accurate: the app ships no
	     encryption of its own and only reaches HTTPS through the OS, which is
	     the exemption. Revisit if we ever bundle our own crypto. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSMicrophoneUsageDescription</key>
	<string>So your eyes can react to sounds in the room. Audio is analysed on your device and never recorded, saved, or sent anywhere.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>processing</string>
	</array>
	<!--
	  Custom-scheme deep links, reserved for scene-code imports
	  (`movingeyes://scene/<code>`). .onOpenURL in iOSApp.swift forwards them
	  to DeepLinkBridge.

	  Universal Links (https://...) require an `Associated Domains`
	  entitlement (`applinks:example.com`) plus an
	  apple-app-site-association file at https://example.com/.well-known/.
	-->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.dangerfield.movingeyes</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>movingeyes</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
