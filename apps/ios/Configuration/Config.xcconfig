// Rewritten by release-please on release, then read straight back out by
// release.yml to set both the App Store version and the Kotlin BuildInfo.
//
// Three parts, not two: release-please only replaces a full major.minor.patch,
// so a bare "1.0" here is silently left alone at every release.
// x-release-please-start-version
MARKETING_VERSION=1.1.0
// x-release-please-end
