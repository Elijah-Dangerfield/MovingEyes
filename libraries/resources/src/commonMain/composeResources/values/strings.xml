    <string name="display_enter">Display</string>
    <!--
      A single percent sign, not the Android-style `%%` escape: Compose
      Resources leaves `%%` alone rather than collapsing it, so escaping here
      renders "100%%" on screen.
    -->
    <string name="display_battery">%1$d%</string>
