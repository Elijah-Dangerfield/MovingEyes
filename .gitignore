*.iml
.kotlin
.gradle
**/build/
xcuserdata
!src/**/build/
local.properties
.idea
.DS_Store
captures
.externalNativeBuild
.cxx
*.xcodeproj/*
!*.xcodeproj/project.pbxproj
!*.xcodeproj/xcshareddata/
!*.xcodeproj/project.xcworkspace/
!*.xcworkspace/contents.xcworkspacedata
**/xcshareddata/WorkspaceSettings.xcsettings
node_modules/

# Leftover from the deleted admin console — a local file that may still hold
# real API tokens. Ignored so it can never be committed; safe to delete.
apps/admin/admin-tokens.local.properties

# Local TestFlight-build credentials (ASC API key etc.). Auto-loaded by
# fastlane; only .env.example is committed.
apps/ios/fastlane/.env
apps/ios/fastlane/.env.local

# Android signing keystores. If this repo is public, a committed keystore is a
# permanent, world-readable leak of the app signing key. Keystores live outside
# the repo (a password manager or key vault); CI reads them from the
# ANDROID_KEYSTORE_BASE64 secret. Never commit one.
*.jks
*.keystore
*.p12
